// ============================================================
// Food Processing Business — Data Model
// Flow: RawMaterial -> Recipe -> Batch -> Product -> Sale
// ============================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Unit {
  G // grams
  KG
  ML
  L
  PIECE
  PACK
}

enum PaymentStatus {
  PAID
  PARTIAL
  UNPAID
}

enum AdjustmentTarget {
  RAW_MATERIAL
  PRODUCT
}

// ------------------------------------------------------------
// 0. AUTH — single seeded user
// ------------------------------------------------------------
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
}

// ------------------------------------------------------------
// 1. RAW MATERIALS
// ------------------------------------------------------------
model RawMaterial {
  id               String   @id @default(cuid())
  name             String
  unit             Unit
  quantityOnHand   Decimal  @default(0) @db.Decimal(12, 3)
  reorderThreshold Decimal  @default(0) @db.Decimal(12, 3)
  averageCost      Decimal  @default(0) @db.Decimal(12, 2) // cost per unit, updated on purchase
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  purchases         RawMaterialPurchase[]
  recipeIngredients RecipeIngredient[]
  batchConsumptions BatchConsumption[]

  @@index([name])
}

// Every time she buys raw material, this increases quantityOnHand
model RawMaterialPurchase {
  id            String      @id @default(cuid())
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id])
  rawMaterialId String
  quantity      Decimal     @db.Decimal(12, 3)
  unitCost      Decimal     @db.Decimal(12, 2)
  totalCost     Decimal     @db.Decimal(12, 2)
  supplier      String?
  purchasedAt   DateTime    @default(now())
  notes         String?

  @@index([rawMaterialId, purchasedAt])
  @@index([purchasedAt])
}

// ------------------------------------------------------------
// 2. PRODUCTS (finished goods) & RECIPES
// ------------------------------------------------------------
model Product {
  id               String   @id @default(cuid())
  name             String // e.g. "Suya Spice Mix 50g"
  packageSize      String? // e.g. "50g", "200g" — free text, keeps it simple
  sellingPrice     Decimal  @db.Decimal(12, 2)
  quantityOnHand   Decimal  @default(0) @db.Decimal(12, 3)
  reorderThreshold Decimal  @default(0) @db.Decimal(12, 3) // powers the product low-stock alert (FR-7)
  trackExpiry      Boolean  @default(true)
  shelfLifeDays    Int? // used to auto-suggest batch expiry
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  recipe    Recipe? // one product = one recipe (a product IS the recipe's output)
  batches   Batch[]
  saleItems SaleItem[]

  @@index([name])
}

// The formula for producing one "yield unit" of a product
model Recipe {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String   @unique
  yieldQty  Decimal  @db.Decimal(12, 3) // finished product one "batch run" of this recipe produces
  yieldUnit Unit
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ingredients RecipeIngredient[]
}

// Line items: "this recipe needs X quantity of raw material Y"
model RecipeIngredient {
  id            String      @id @default(cuid())
  recipe        Recipe      @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId      String
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id])
  rawMaterialId String
  quantity      Decimal     @db.Decimal(12, 3) // amount needed per one recipe yield

  @@unique([recipeId, rawMaterialId])
}

// ------------------------------------------------------------
// 3. PRODUCTION / BATCHES
// ------------------------------------------------------------
model Batch {
  id           String    @id @default(cuid())
  batchNumber  String    @unique // e.g. "SUYA-20260829-01"
  product      Product   @relation(fields: [productId], references: [id])
  productId    String
  quantityMade Decimal   @db.Decimal(12, 3)
  unitCost     Decimal   @default(0) @db.Decimal(12, 2) // material cost per unit at production time
  producedAt   DateTime  @default(now())
  expiryDate   DateTime?
  notes        String?

  consumptions BatchConsumption[] // actual raw materials deducted for this specific run

  @@index([productId, producedAt])
  @@index([expiryDate])
}

// Records exactly what raw materials were consumed for a given batch
// (snapshot of the recipe at production time — kept separate for traceability
// even if the recipe changes later)
model BatchConsumption {
  id            String      @id @default(cuid())
  batch         Batch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  batchId       String
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id])
  rawMaterialId String
  quantityUsed  Decimal     @db.Decimal(12, 3)
  unitCost      Decimal     @default(0) @db.Decimal(12, 2) // averageCost at time of consumption

  @@index([rawMaterialId])
}

// ------------------------------------------------------------
// 4. CUSTOMERS & SALES
// ------------------------------------------------------------
model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  createdAt DateTime @default(now())

  sales Sale[]

  @@index([name])
}

model Sale {
  id            String        @id @default(cuid())
  customer      Customer?     @relation(fields: [customerId], references: [id])
  customerId    String?
  saleDate      DateTime      @default(now())
  totalAmount   Decimal       @db.Decimal(12, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(12, 2)
  paymentStatus PaymentStatus @default(PAID)
  notes         String?

  items SaleItem[]

  @@index([saleDate])
  @@index([paymentStatus, saleDate])
  @@index([customerId])
}

model SaleItem {
  id        String  @id @default(cuid())
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId    String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Decimal @db.Decimal(12, 3)
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)
  unitCost  Decimal @default(0) @db.Decimal(12, 2) // material cost per unit at sale time -> COGS

  @@index([productId])
}

// ------------------------------------------------------------
// 5. EXPENSES (non-raw-material costs)
// ------------------------------------------------------------
model Expense {
  id       String   @id @default(cuid())
  category String // e.g. "Transport", "Packaging Design", "Rent"
  amount   Decimal  @db.Decimal(12, 2)
  date     DateTime @default(now())
  notes    String?

  @@index([date])
  @@index([category, date])
}

model ExpenseCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ------------------------------------------------------------
// 6. STOCK ADJUSTMENTS — the reconciliation safety valve
// Lets her physically count stock and reset the system to reality,
// logging the variance instead of silently discarding it.
// ------------------------------------------------------------
model StockAdjustment {
  id              String           @id @default(cuid())
  targetType      AdjustmentTarget
  rawMaterialId   String?
  productId       String?
  systemQuantity  Decimal          @db.Decimal(12, 3) // what the system thought
  countedQuantity Decimal          @db.Decimal(12, 3) // what she actually counted
  variance        Decimal          @db.Decimal(12, 3) // counted - system
  reason          String? // "spillage", "forgot to log sale", "gift"
  adjustedAt      DateTime         @default(now())

  @@index([targetType, adjustedAt])
  @@index([rawMaterialId])
  @@index([productId])
}

// ------------------------------------------------------------
// 7. SETTINGS — single row, keyed 'singleton'
// ------------------------------------------------------------
model Settings {
  id             String   @id @default("singleton")
  businessName   String   @default("GFO Foods")
  currency       String   @default("NGN")
  reminderOn     Boolean  @default(false)
  reminderHour   Int      @default(20) // 0-23, Africa/Lagos
  updatedAt      DateTime @updatedAt
}
